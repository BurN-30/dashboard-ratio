# Session Sync - Configuration
# Dupliquer en .env (jamais commité). Une variable d'environnement utilisateur du même nom
# l'emporte sur ce fichier.

# Adresse de TrackBoard (https obligatoire, certificat vérifié), sans barre finale.
# Par Tailscale : nom complet de la machine, celui du certificat.
TRACKBOARD_URL=https://machine.exemple.ts.net:8444

# Jeton dédié au dépôt de session (DOIT être identique à SESSION_SYNC_TOKEN du .env serveur).
# Il n'ouvre que POST /scrapers/session/{tracker}, pas l'interface ni les autres routes.
# Générer avec : openssl rand -hex 32
SESSION_SYNC_TOKEN=change_me_to_match_server

# --- Facultatif ---
# Tracker à session manuelle
# SESSION_SYNC_TRACKER=C411
# Attente de la connexion manuelle dans la fenêtre ouverte (minutes)
# SESSION_SYNC_ATTENTE_MIN=30
# Session du profil à moins de tant d'heures de son échéance : nouvelle connexion demandée.
# Doit dépasser l'intervalle de la tâche (6 jours = 144 h).
# SESSION_SYNC_SEUIL_HEURES=150
# Navigateur installé à piloter (msedge, chrome)
# SESSION_SYNC_CANAL=msedge
# Dossier du journal (défaut : logs\ à côté du script)
# SESSION_SYNC_LOG_DIR=
# Dossier du profil de navigateur dédié (défaut : %LOCALAPPDATA%\TrackBoard\session-sync)
# SESSION_SYNC_DATA_DIR=
